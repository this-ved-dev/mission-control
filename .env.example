# Copy to .env and fill in. Never commit .env.
# foundry = Claude on Azure AI Foundry; fake = scripted offline model (demo/CI)
MC_LLM=foundry
ANTHROPIC_FOUNDRY_API_KEY=replace-me
# Your Foundry resource name (the <resource> in https://<resource>.services.ai.azure.com)
ANTHROPIC_FOUNDRY_RESOURCE=replace-me
# Foundry deployment name of Claude Sonnet 5.5
MC_MODEL=claude-sonnet-5-5
MC_DB_PATH=data/mission_control.db
# Host port for docker compose (container always listens on 8000)
MC_PORT=8000
