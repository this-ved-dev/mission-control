# Any OpenAI-compatible Chat Completions host. Ollama serves one at /v1.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:12b
# "none" turns off hidden reasoning on local thinking models (much faster). Leave empty for hosts that reject it.
LLM_REASONING_EFFORT=none
# Optional per-step overrides
# LLM_MODEL_FAST=
# LLM_MODEL_WRITER=
# Optional notional price for the local model, USD per million tokens
# LLM_PRICE_INPUT_PER_M=0
# LLM_PRICE_OUTPUT_PER_M=0
