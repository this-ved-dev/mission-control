{
  "openapi": "3.1.0",
  "info": {
    "title": "Mission Control",
    "description": "Go/No-Go launch console: anomaly reports in, human-approved briefings out.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/reports": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "List Reports",
        "operationId": "list_reports_api_reports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ReportOut"
                  },
                  "type": "array",
                  "title": "Response List Reports Api Reports Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Create Report",
        "operationId": "create_report_api_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportOut"
                }
              }
            }
          },
          "422": {
            "description": "Invalid report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{report_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Report",
        "operationId": "get_report_api_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReportIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "station": {
            "type": "string",
            "enum": [
              "PROP",
              "GNC",
              "COMMS",
              "WX",
              "GND",
              "RANGE"
            ],
            "title": "Station"
          },
          "wind_knots": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Wind Knots"
          },
          "temp_c": {
            "type": "number",
            "maximum": 60.0,
            "minimum": -60.0,
            "title": "Temp C"
          },
          "fuel_pct": {
            "type": "number",
            "maximum": 150.0,
            "minimum": 0.0,
            "title": "Fuel Pct"
          },
          "note": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "name",
          "station",
          "wind_knots",
          "temp_c",
          "fuel_pct",
          "note"
        ],
        "title": "ReportIn"
      },
      "ReportOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "station": {
            "type": "string",
            "enum": [
              "PROP",
              "GNC",
              "COMMS",
              "WX",
              "GND",
              "RANGE"
            ],
            "title": "Station"
          },
          "wind_knots": {
            "type": "number",
            "title": "Wind Knots"
          },
          "temp_c": {
            "type": "number",
            "title": "Temp C"
          },
          "fuel_pct": {
            "type": "number",
            "title": "Fuel Pct"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "go",
              "no_go"
            ],
            "title": "Verdict"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/ViolationOut"
            },
            "type": "array",
            "title": "Violations"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepOut"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "name",
          "station",
          "wind_knots",
          "temp_c",
          "fuel_pct",
          "note",
          "verdict",
          "violations",
          "status",
          "steps"
        ],
        "title": "ReportOut"
      },
      "StepOut": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "model"
            ],
            "title": "Kind"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "cost_usd": {
            "type": "string",
            "title": "Cost Usd"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "fallback",
              "error"
            ],
            "title": "Status"
          },
          "output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "name",
          "kind",
          "model",
          "started_at",
          "duration_ms",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "status",
          "output"
        ],
        "title": "StepOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationErrorOut": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "errors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "title": "ValidationErrorOut"
      },
      "ViolationOut": {
        "properties": {
          "reading": {
            "type": "string",
            "title": "Reading"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "reading",
          "value",
          "message"
        ],
        "title": "ViolationOut"
      }
    }
  }
}
